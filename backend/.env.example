# Azure AI Foundry — copia este archivo como .env y completa los valores
AZURE_AI_ENDPOINT=https://<tu-recurso>.services.ai.azure.com/openai/v1
AZURE_AI_API_KEY=<tu-clave-de-api>
AZURE_AI_DEPLOYMENT=gpt-5

# Límite de uso del chat
CHAT_MAX_QUESTIONS=5
CHAT_WINDOW_HOURS=24

# Servidor
PORT=5000
FLASK_DEBUG=1
CORS_ORIGINS=*

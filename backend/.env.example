# Azure AI Foundry — copia este archivo como .env y completa los valores
AZURE_AI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_AI_API_KEY=<tu-clave-de-api>
AZURE_AI_DEPLOYMENT=gpt-5
# La Responses API de Azure exige 2025-03-01-preview o posterior.
AZURE_AI_API_VERSION=2025-04-01-preview

# Límite de uso del chat
CHAT_MAX_QUESTIONS=5
CHAT_WINDOW_HOURS=24

# Servidor
PORT=5000
FLASK_DEBUG=1
CORS_ORIGINS=*

# En PythonAnywhere (o detrás de cualquier proxy) pon 1 para leer la IP real del
# visitante desde X-Real-IP. Sin esto todos comparten la misma cuota del chat.
TRUST_PROXY=0
